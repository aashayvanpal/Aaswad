{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions":true
  },
  "include": [
    "server.js",
    "models",
    "client/src/controllers",
    "client/src/config",
    "client/src/middlewares"
  ],
  "exclude": [
    "node_modules",
    "client/node_modules",
    "client/src/components",
    "dist"
  ]
}
